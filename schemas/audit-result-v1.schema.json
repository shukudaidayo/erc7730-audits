{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shukudaidayo/erc7730-audits/main/schemas/audit-result-v1.schema.json",
  "title": "ERC-7730 descriptor audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "policyVersion",
    "status",
    "auditor",
    "descriptor",
    "scope",
    "findings",
    "limitations",
    "testing",
    "evidence",
    "createdAt"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": ["draft", "ready-for-attestation", "approved", "needs-changes", "rejected"]
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/caip10" },
        "profile": { "$ref": "#/$defs/repositoryRelativePath" }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "erc7730Version", "hash", "snapshot"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "path"],
          "properties": {
            "repository": { "type": "string", "format": "uri" },
            "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        "erc7730Version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["declaredReference", "snapshot", "hash"],
          "properties": {
            "declaredReference": { "type": "string", "minLength": 1 },
            "snapshot": { "$ref": "#/$defs/relativePath" },
            "hash": { "$ref": "#/$defs/descriptorHash" }
          }
        },
        "hash": { "$ref": "#/$defs/descriptorHash" },
        "snapshot": { "$ref": "#/$defs/relativePath" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployments", "formatsReviewed"],
      "properties": {
        "deployments": {
          "type": "array",
          "items": { "$ref": "#/$defs/caip10" },
          "uniqueItems": true
        },
        "formatsReviewed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signature", "result"],
            "properties": {
              "signature": { "type": "string", "minLength": 1 },
              "selector": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
              "result": { "enum": ["pass", "fail", "not-applicable"] },
              "boundaryRationale": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/limitation" }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "result", "tool", "toolVersion", "command"],
      "properties": {
        "fixture": { "$ref": "#/$defs/relativePath" },
        "result": { "enum": ["pass", "fail", "not-run"] },
        "results": { "$ref": "#/$defs/relativePath" },
        "tool": { "type": "string", "minLength": 1 },
        "toolVersion": { "type": "string", "minLength": 1 },
        "toolCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "command": { "type": "string", "minLength": 1 },
        "externalData": {
          "type": "array",
          "items": { "$ref": "#/$defs/externalDataSnapshot" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "result": { "enum": ["pass", "fail"] } },
            "required": ["result"]
          },
          "then": {
            "properties": { "results": {} },
            "required": ["results"]
          }
        },
        {
          "if": {
            "properties": { "result": { "const": "not-run" } },
            "required": ["result"]
          },
          "then": {
            "properties": {
              "results": false,
              "externalData": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": { "enum": ["pass", "fail"] },
              "tool": { "const": "@ethereum-sourcify/clear-signing-test-runner" }
            },
            "required": ["result", "tool"]
          },
          "then": {
            "properties": {
              "externalData": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": { "format": { "const": "chain-info-v1" } },
                  "required": ["format"]
                }
              },
              "toolCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
            },
            "required": ["externalData", "toolCommit"]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployments", "dependencies", "report"],
      "properties": {
        "deployments": { "$ref": "#/$defs/relativePath" },
        "dependencies": { "$ref": "#/$defs/relativePath" },
        "report": { "$ref": "#/$defs/relativePath" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schemaUID", "uid", "file"],
      "properties": {
        "type": { "const": "eas-offchain" },
        "schemaUID": {
          "const": "0xe023eef113c1670774801c34b377fdf612dd8a4d2fa92fe382e15bd91fafb5c2"
        },
        "uid": { "$ref": "#/$defs/bytes32" },
        "file": { "$ref": "#/$defs/relativePath" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["ready-for-attestation", "approved"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "descriptor": {
            "type": "object",
            "properties": { "schema": {} },
            "required": ["schema"]
          },
          "scope": {
            "type": "object",
            "properties": {
              "formatsReviewed": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "result": { "const": "pass" },
                    "boundaryRationale": { "type": "string", "minLength": 1 }
                  },
                  "required": ["boundaryRationale"]
                }
              }
            }
          },
          "testing": {
            "type": "object",
            "properties": {
              "result": { "const": "pass" },
              "results": {}
            },
            "required": ["results"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "approved" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "attestation": {} },
        "required": ["attestation"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "ready-for-attestation" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "attestation": false }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["needs-changes", "rejected"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "attestation": false,
          "findings": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "blocking": { "const": true },
                "status": { "enum": ["open", "accepted"] }
              },
              "required": ["blocking", "status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "draft" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "attestation": false,
          "reviewedAt": false
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "not": { "const": "draft" } } },
        "required": ["status"]
      },
      "then": {
        "properties": { "reviewedAt": {} },
        "required": ["reviewedAt"]
      }
    }
  ],
  "$defs": {
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "caip10": {
      "type": "string",
      "pattern": "^eip155:[0-9]+:0x[0-9a-fA-F]{40}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "pattern": "^(?!/).+$"
    },
    "descriptorHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "algorithm", "value"],
      "properties": {
        "standard": { "const": "ERC-8176" },
        "algorithm": { "const": "keccak256-rfc8785-jcs" },
        "value": { "$ref": "#/$defs/bytes32" }
      }
    },
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "$ref": "#/$defs/bytes32" }
      }
    },
    "externalDataSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "snapshot", "capturedAt", "hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "format": { "enum": ["chain-info-v1"] },
        "source": { "type": "string", "format": "uri" },
        "snapshot": { "$ref": "#/$defs/relativePath" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "hash": { "$ref": "#/$defs/fileHash" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "blocking", "status", "title", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
        "blocking": { "type": "boolean" },
        "status": { "enum": ["open", "resolved", "accepted"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "affectedFormats": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "impact"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "reason": {
          "enum": [
            "compatible-not-included",
            "proxy-not-bindable",
            "source-not-verified",
            "behavior-not-compatible",
            "legacy-network"
          ]
        },
        "signature": { "type": "string" },
        "selector": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
        "deployments": {
          "type": "array",
          "items": { "$ref": "#/$defs/caip10" },
          "minItems": 1,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "minItems": 1,
          "uniqueItems": true
        },
        "impact": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "omitted-deployment" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "deployments": {},
              "sources": {}
            },
            "required": ["deployments", "sources"]
          },
          "else": {
            "properties": { "reason": false }
          }
        }
      ]
    }
  }
}
