{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shukudaidayo/erc7730-audits/main/schemas/dependencies-v1.schema.json",
  "title": "ERC-7730 included dependency lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "descriptorHash", "dependencies"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": "1.0.0" },
    "descriptorHash": { "$ref": "#/$defs/bytes32" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" },
      "uniqueItems": true
    },
    "resolvedDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "hash"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/relativePath" },
        "hash": { "$ref": "#/$defs/contentHash" }
      }
    }
  },
  "$defs": {
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "algorithm", "value"],
      "properties": {
        "standard": { "const": "ERC-8176" },
        "algorithm": { "const": "keccak256-rfc8785-jcs" },
        "value": { "$ref": "#/$defs/bytes32" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaredReference", "resolvedReference", "commit", "hash"],
      "properties": {
        "declaredReference": { "type": "string", "minLength": 1 },
        "resolvedReference": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "path": { "type": "string", "minLength": 1 },
        "snapshot": { "$ref": "#/$defs/relativePath" },
        "hash": { "$ref": "#/$defs/contentHash" }
      },
      "anyOf": [
        {
          "properties": { "snapshot": {} },
          "required": ["snapshot"]
        },
        {
          "properties": {
            "repository": {},
            "commit": {},
            "path": {}
          },
          "required": ["repository", "commit", "path"]
        }
      ]
    }
  }
}
