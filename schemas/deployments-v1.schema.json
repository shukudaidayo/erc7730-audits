{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shukudaidayo/erc7730-audits/main/schemas/deployments-v1.schema.json",
  "title": "ERC-7730 audit deployment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "descriptorHash", "capturedAt", "deployments"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": "1.0.0" },
    "descriptorHash": { "$ref": "#/$defs/bytes32" },
    "capturedAt": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "deployments": {
      "type": "array",
      "items": { "$ref": "#/$defs/deployment" }
    }
  },
  "$defs": {
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^/"
    },
    "sourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcify"],
      "properties": {
        "sourcify": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence"],
          "properties": {
            "status": {
              "enum": ["verified", "chain-unsupported", "not-verified"]
            },
            "url": { "type": "string", "format": "uri" },
            "evidence": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "status": { "const": "verified" } },
                "required": ["status"]
              },
              "then": {
                "properties": { "url": {} },
                "required": ["url"]
              }
            }
          ]
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "url", "reason"],
          "properties": {
            "provider": { "const": "block-explorer" },
            "url": { "type": "string", "format": "uri" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "sourceCommit": { "type": "string", "minLength": 1 },
        "abiHash": { "$ref": "#/$defs/bytes32" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourcify": {
                "type": "object",
                "properties": { "status": { "const": "chain-unsupported" } },
                "required": ["status"]
              }
            },
            "required": ["sourcify"]
          },
          "then": {
            "properties": { "fallback": {} },
            "required": ["fallback"]
          }
        }
      ]
    },
    "implementation": {
      "description": "An implementation contract or EIP-2535 facet that executes at least one reviewed format.",
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "runtimeCodeHash", "sourceVerification"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "runtimeCodeHash": { "$ref": "#/$defs/bytes32" },
        "sourceVerification": { "$ref": "#/$defs/sourceVerification" },
        "selectors": {
          "type": "array",
          "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
          "uniqueItems": true
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "upgradeability", "evidence"],
      "properties": {
        "type": {
          "enum": ["none", "eip1967", "eip1822", "eip2535", "custom", "unknown"]
        },
        "upgradeability": {
          "enum": ["not-proxy", "immutable", "administrator-controlled", "unknown"]
        },
        "implementations": {
          "description": "Implementation contracts that execute reviewed formats. For EIP-2535, list the facets mapped to reviewed selectors.",
          "type": "array",
          "items": { "$ref": "#/$defs/implementation" }
        },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "none" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "upgradeability": { "const": "not-proxy" },
              "implementations": { "type": "array", "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "upgradeability": {
                "enum": ["immutable", "administrator-controlled", "unknown"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["eip1967", "eip1822", "eip2535", "custom"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "implementations": { "type": "array", "minItems": 1 }
            },
            "required": ["implementations"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "unknown" } },
            "required": ["type"]
          },
          "then": {
            "properties": { "upgradeability": { "const": "unknown" } }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "eip2535" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "implementations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "selectors": { "type": "array", "minItems": 1 }
                  },
                  "required": ["selectors"]
                }
              }
            }
          }
        }
      ]
    },
    "stateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "slot",
        "value",
        "purpose",
        "affectedFormats",
        "evidence"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/address" },
        "slot": { "$ref": "#/$defs/bytes32" },
        "value": { "$ref": "#/$defs/bytes32" },
        "mask": { "$ref": "#/$defs/bytes32" },
        "purpose": { "type": "string", "minLength": 1 },
        "affectedFormats": {
          "type": "array",
          "items": { "$ref": "#/$defs/signature" },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "displayBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "result", "rationale"],
      "properties": {
        "formats": {
          "type": "array",
          "items": { "$ref": "#/$defs/signature" },
          "minItems": 1,
          "uniqueItems": true
        },
        "result": {
          "enum": ["not-required", "enforced", "not-enforceable"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "descriptorConstraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonPointer" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "result": { "const": "enforced" } },
            "required": ["result"]
          },
          "then": {
            "properties": { "descriptorConstraints": {} },
            "required": ["descriptorConstraints"]
          }
        },
        {
          "if": {
            "properties": { "result": { "const": "not-required" } },
            "required": ["result"]
          },
          "then": {
            "properties": {
              "descriptorConstraints": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "preFilter",
        "observedAtBlock",
        "observedAtBlockHash",
        "runtimeCodeHash",
        "sourceVerification",
        "proxy",
        "displayBindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^eip155:[0-9]+:0x[0-9a-fA-F]{40}$"
        },
        "preFilter": {
          "enum": [
            "pass-direct",
            "pass-bindable-proxy",
            "fail-source-verification",
            "fail-descriptor-binding"
          ]
        },
        "observedAtBlock": { "type": "integer", "minimum": 0 },
        "observedAtBlockHash": { "$ref": "#/$defs/bytes32" },
        "runtimeCodeHash": { "$ref": "#/$defs/bytes32" },
        "sourceVerification": { "$ref": "#/$defs/sourceVerification" },
        "proxy": { "$ref": "#/$defs/proxy" },
        "stateRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/stateRef" }
        },
        "displayBindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/displayBinding" },
          "minItems": 1
        },
        "notes": { "type": "string" }
      }
    }
  }
}
