{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shukudaidayo/erc7730-audits/main/schemas/chain-info-v1.schema.json",
  "title": "Resolved chain information used by ERC-7730 rendering tests",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "source", "chainIds", "entries"],
  "properties": {
    "formatVersion": { "const": "1.0.0" },
    "source": { "type": "string", "format": "uri" },
    "chainIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chainInfo" }
    }
  },
  "$defs": {
    "chainInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "name", "nativeCurrency"],
      "properties": {
        "chainId": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "nativeCurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "symbol", "decimals"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 },
            "decimals": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
