{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shukudaidayo/erc7730-audits/main/schemas/tests-v2.schema.json",
  "title": "ERC-7730 audit rendering fixtures, version 2",
  "description": "Sourcify-runner fixtures whose inputs are expected to render successfully. Expected-error checks are recorded separately in the audit report.",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptor", "tests"],
  "properties": {
    "$schema": { "type": "string" },
    "descriptor": {
      "type": "string",
      "minLength": 1
    },
    "dataProvider": { "$ref": "#/$defs/dataProvider" },
    "additionalChainInfoChainIds": {
      "description": "Extra chain IDs that a tested cross-chain format may resolve beyond its transaction or EIP-712 domain chain ID.",
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/calldataTest" },
          { "$ref": "#/$defs/eip712Test" }
        ]
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "dataProvider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "object",
          "propertyNames": { "pattern": "^0x[0-9a-f]{40}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "decimals", "name"],
            "properties": {
              "symbol": { "type": "string" },
              "decimals": { "type": "integer", "minimum": 0 },
              "name": { "type": "string" }
            }
          }
        },
        "addressNames": {
          "type": "object",
          "propertyNames": { "pattern": "^0x[0-9a-f]{40}$" },
          "additionalProperties": { "type": "string" }
        },
        "ensNames": {
          "type": "object",
          "propertyNames": { "pattern": "^0x[0-9a-f]{40}$" },
          "additionalProperties": {
            "type": "string",
            "pattern": "\\.eth$"
          }
        },
        "nftCollectionNames": {
          "type": "object",
          "propertyNames": { "pattern": "^0x[0-9a-f]{40}$" },
          "additionalProperties": { "type": "string" }
        },
        "blockTimestamps": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "calldataTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "caseType", "rawTx", "expected"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "caseType": { "enum": ["typical", "boundary"] },
        "rawTx": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        },
        "from": { "$ref": "#/$defs/address" },
        "txHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "expected": { "$ref": "#/$defs/renderedOutput" }
      }
    },
    "eip712Test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "caseType", "data", "expected"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "caseType": { "enum": ["typical", "boundary"] },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["types", "primaryType", "domain", "message"],
          "properties": {
            "types": { "type": "object" },
            "primaryType": { "type": "string", "minLength": 1 },
            "domain": { "type": "object" },
            "message": { "type": "object" }
          }
        },
        "expected": { "$ref": "#/$defs/renderedOutput" }
      }
    },
    "renderedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "fields"],
      "properties": {
        "intent": { "type": "string" },
        "interpolatedIntent": { "type": "string" },
        "owner": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/renderedField" }
        }
      }
    },
    "renderedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/$defs/renderedOutput" }
          ]
        }
      }
    }
  }
}
